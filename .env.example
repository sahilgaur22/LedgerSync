# Database connection strings (PostgreSQL required for native enums, UUID, and stored generated columns)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledgersync
READONLY_DATABASE_URL=postgresql://ledgersync_readonly:readonly_pass@localhost:5432/ledgersync

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Engine Parameters
SETTLEMENT_WINDOW_DAYS=3
SUBSET_SUM_TIMEOUT_MS=200
TOLERANCE_PAISE=0
CHUNK_SIZE=100
